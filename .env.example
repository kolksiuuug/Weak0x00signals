# Шаблон переменных окружения. Скопируйте в .env и заполните.
# ФАЙЛ .env В РЕПОЗИТОРИЙ НЕ КОММИТИТСЯ (CLAUDE.md §5).
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env

# --- Публичный вход (Caddy) -------------------------------------------------
# Локально оставьте как есть — Caddy слушает http://localhost без TLS.
# На VPS укажите домен БЕЗ схемы, тогда Caddy сам получит сертификат Let's Encrypt:
#   DOMAIN=signals.example.ru
DOMAIN=http://localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=signals
POSTGRES_PASSWORD=
POSTGRES_DB=signals

# --- LLM (CLAUDE.md §2.4: только белый список ТЗ, автовыбор запрещён) --------
# Допустимые значения LLM_MODEL:
#   GigaChat 2 Lite | GigaChat 2 Pro | GigaChat 2 Max
#   YandexGPT Lite 5 | YandexGPT Pro 5 | YandexGPT Pro 5.1
#   Qwen3.6 35B-A3B | Qwen3 235B | gpt-4.1 | gpt-5.6-luna
LLM_MODEL=GigaChat 2 Lite

GIGACHAT_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENAI_API_KEY=

# --- Прочее -----------------------------------------------------------------
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.75
