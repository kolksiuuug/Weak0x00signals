# Copy this file to .env before starting the stack.
POSTGRES_PASSWORD=signals123
POSTGRES_USER=signals
POSTGRES_DB=signals

# One explicitly selected model from the competition whitelist.
LLM_MODEL=GigaChat 2 Max
GIGACHAT_API_KEY=
GIGACHAT_RQUID=
GIGACHAT_VERIFY_SSL=true
LLM_REQUIRED=true

# Optional providers (leave empty unless that provider is selected).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT=45
HTTP_TIMEOUT=90
CONFIDENCE_THRESHOLD=0.75
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ALLOW_HASH_FALLBACK=false
LOG_LEVEL=INFO

DOMAIN=http://localhost

# Existing Nginx Proxy Manager integration
PROXY_NETWORK=weak-signals-proxy
NPM_CONTAINER=nginx_proxy_manager
LOCAL_PORT=18080

# IMPORTANT: final/demo mode uses live sources only.
DEV_MOCK_FALLBACK=false

# Enrich one opened signal with the selected LLM; all fields except the source title are Russian.
LLM_LAZY_ENRICHMENT=true
LLM_SEARCH_EXPANSION=false
